#!/usr/bin/env python3
"""Writes Sources/HoneycombCore/Models/ModelCatalog+Generated.swift.

Pins each model to a Hugging Face commit and records every file's size and SHA-256,
so the app downloads exactly these bytes and rejects anything else.
Usage: ./scripts/make-catalog
"""
import fnmatch
import hashlib
import json
import pathlib
import urllib.request

MODELS = [
    dict(id="silero-vad", kind="vad", name="Silero voice detector", repo="FluidInference/silero-vad-coreml",
         include=["silero-vad-unified-256ms-v6.2.1.mlmodelc/*"],
         license="MIT", credit="Silero VAD by Silero Team, converted to Core ML by FluidInference."),
    dict(id="parakeet-tdt-0.6b-v2", kind="asr", name="Parakeet speech-to-text (English)",
         repo="FluidInference/parakeet-tdt-0.6b-v2-coreml",
         include=["Preprocessor.mlmodelc/*", "Encoder.mlmodelc/*", "Decoder.mlmodelc/*", "JointDecision.mlmodelc/*",
                  "parakeet_vocab.json"],
         license="CC-BY-4.0", credit="Parakeet TDT 0.6B v2 by NVIDIA, converted to Core ML by FluidInference."),
    dict(id="qwen3.5-4b", kind="llm", name="Qwen3.5 4B", repo="mlx-community/Qwen3.5-4B-MLX-4bit",
         include=["config.json", "model*.safetensors", "model.safetensors.index.json", "tokenizer.json",
                  "tokenizer_config.json", "chat_template.jinja", "vocab.json", "generation_config.json"],
         license="Apache-2.0", credit="Qwen3.5 by the Qwen team at Alibaba, converted to MLX by mlx-community."),
    dict(id="qwen3-embedding-0.6b", kind="embed", name="Qwen3 Embedding 0.6B",
         repo="mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ",
         include=["config.json", "model*.safetensors", "model.safetensors.index.json", "tokenizer.json",
                  "tokenizer_config.json", "vocab.json", "merges.txt", "added_tokens.json", "special_tokens_map.json"],
         license="Apache-2.0", credit="Qwen3 Embedding by the Qwen team at Alibaba, converted to MLX by mlx-community."),
]


def get(url):
    with urllib.request.urlopen(url) as response:
        return response.read()


def entry(model):
    info = json.loads(get(f"https://huggingface.co/api/models/{model['repo']}"))
    revision = info["sha"]
    tree = json.loads(get(f"https://huggingface.co/api/models/{model['repo']}/tree/{revision}?recursive=true"))
    files = []
    for item in tree:
        if item["type"] != "file" or not any(fnmatch.fnmatch(item["path"], p) for p in model["include"]):
            continue
        sha = item["lfs"]["oid"] if item.get("lfs") else hashlib.sha256(
            get(f"https://huggingface.co/{model['repo']}/resolve/{revision}/{item['path']}")).hexdigest()
        files.append((item["path"], item["size"], sha))
    assert files, f"no files matched for {model['id']}"
    files.sort()
    lines = [f'            ModelFile(path: "{p}", size: {s}, sha256: "{h}"),' for p, s, h in files]
    return f'''        ModelSpec(
            id: "{model['id']}", kind: .{model['kind']}, name: "{model['name']}",
            repo: "{model['repo']}", revision: "{revision}",
            license: "{model['license']}",
            credit: "{model['credit']}",
            files: [
{chr(10).join(lines)}
            ]),'''


body = "\n".join(entry(m) for m in MODELS)
out = pathlib.Path(__file__).resolve().parent.parent / "Sources/HoneycombCore/Models/ModelCatalog+Generated.swift"
out.write_text(f"""// Generated by scripts/make-catalog. Do not edit.

extension ModelCatalog {{
    static let generated: [ModelSpec] = [
{body}
    ]
}}
""")
print(f"Wrote {out}")
